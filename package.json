{
  "name": "tx-6-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/tx-6",
    "packages/use-tx-6",
    "demo"
  ],
  "scripts": {
    "build": "bun run --cwd packages/tx-6 build && bun run --cwd packages/use-tx-6 build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "smoke": "node scripts/smoke.mjs",
    "check": "bun run lint && bun run typecheck && bun test && bun run build && bun run smoke",
    "pack": "rm -rf packed && mkdir packed && (cd packages/tx-6 && bun pm pack --destination ../../packed) && (cd packages/use-tx-6 && bun pm pack --destination ../../packed)",
    "demo": "bun run --cwd demo dev",
    "demo:build": "bun run --cwd demo build",
    "demo:deploy": "wrangler deploy",
    "demo:preview": "wrangler dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@ulnd/tx-6": "workspace:*",
    "@ulnd/use-tx-6": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.141.0"
  }
}
