{
  "name": "use-tx-6",
  "version": "2.0.0",
  "description": "Platform-agnostic driver and React hooks for the teenage engineering TX-6 over MIDI",
  "keywords": [
    "teenage-engineering",
    "tx-6",
    "midi",
    "ble-midi",
    "web-bluetooth",
    "web-midi",
    "react",
    "hooks"
  ],
  "repository": "https://github.com/darnfish/use-tx-6.git",
  "author": "William Gibson <william@darn.fish>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./web-bluetooth": {
      "types": "./dist/transports/web-bluetooth.d.ts",
      "default": "./dist/transports/web-bluetooth.js"
    },
    "./web-midi": {
      "types": "./dist/transports/web-midi.d.ts",
      "default": "./dist/transports/web-midi.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "prepublishOnly": "bun run check"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@happy-dom/global-registrator": "^20.14.5",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
