{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"types": ["vite/client", "node"],
		"noEmit": true,
		"paths": {
			"use-tx-6": ["../src/index.ts"],
			"use-tx-6/react": ["../src/react/index.tsx"],
			"use-tx-6/web-bluetooth": ["../src/transports/web-bluetooth.ts"],
			"use-tx-6/web-midi": ["../src/transports/web-midi.ts"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
