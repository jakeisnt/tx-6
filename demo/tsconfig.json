{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"types": ["vite/client", "node"],
		"noEmit": true,
		"paths": {
			"@ulnd/tx-6": ["../packages/tx-6/src/index.ts"],
			"@ulnd/tx-6/web-bluetooth": ["../packages/tx-6/src/transports/web-bluetooth.ts"],
			"@ulnd/tx-6/web-midi": ["../packages/tx-6/src/transports/web-midi.ts"],
			"@ulnd/use-tx-6": ["../packages/use-tx-6/src/index.tsx"]
		}
	},
	"include": ["src", "vite.config.ts"]
}
