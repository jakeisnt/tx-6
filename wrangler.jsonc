{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Static-assets-only Worker serving the TX-6 browser demo
	"name": "tx-6",
	"compatibility_date": "2026-09-26",
	"build": {
		"command": "bun run demo:build"
	},
	"assets": {
		"directory": "./demo/dist",
		"not_found_handling": "single-page-application"
	}
}
