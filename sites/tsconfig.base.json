{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"types": ["vite/client", "node"],
		"noEmit": true,
		// Mirrors the aliases in te-site-kit/vite.ts
		"paths": {
			"@ulnd/tx-6": ["../packages/tx-6/src/index.ts"],
			"@ulnd/tp-7": ["../packages/tp-7/src/index.ts"],
			"@ulnd/op-1": ["../packages/op-1/src/index.ts"],
			"@ulnd/te-device": ["../packages/te-device/src/index.ts"],
			"@ulnd/te-device/*": ["../packages/te-device/src/transports/*.ts"],
			"@ulnd/use-te-device": ["../packages/use-te-device/src/index.tsx"],
			"@ulnd/teenage": ["../packages/teenage/src/index.ts"],
			"@ulnd/teenage/*": ["../packages/teenage/src/*.ts"],
			"@ulnd/te-site-kit": ["./te-site-kit/src/index.ts"],
			"@ulnd/te-site-kit/vite": ["./te-site-kit/vite.ts"]
		}
	}
}
