{
  "name": "@ulnd/tx-6",
  "version": "0.1.0",
  "description": "Headless driver for the teenage engineering TX-6 over MIDI: decodes its controls in any JavaScript runtime, with Web Bluetooth and Web MIDI transports",
  "keywords": [
    "teenage-engineering",
    "tx-6",
    "midi",
    "ble-midi",
    "web-bluetooth",
    "web-midi",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakeisnt/tx-6.git",
    "directory": "packages/tx-6"
  },
  "author": "Jake Chvatal <jake@uln.industries>",
  "contributors": [
    "William Gibson <william@darn.fish>"
  ],
  "license": "MIT",
  "homepage": "https://tx-6.jake.kitchen",
  "bugs": "https://github.com/jakeisnt/tx-6/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web-bluetooth": {
      "types": "./dist/transports/web-bluetooth.d.ts",
      "default": "./dist/transports/web-bluetooth.js"
    },
    "./web-midi": {
      "types": "./dist/transports/web-midi.d.ts",
      "default": "./dist/transports/web-midi.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "bun run build"
  }
}
