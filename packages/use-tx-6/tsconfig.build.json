{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		// No DOM, Node or Bun globals: React is the only host dependency
		"lib": ["es2022"],
		"types": [],
		// Resolve @ulnd/tx-6 through node_modules to its build, not its source
		"paths": {},
		"allowImportingTsExtensions": false,
		"noEmit": false,
		"rootDir": "src",
		"outDir": "dist",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true
	},
	"include": ["src"]
}
